<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import java.net.URL?>
<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="co.edu.uniquindio.poo.proyectoclinicafx.controladores.PanelPrincipalController">


    <!-- Encabezado -->
    <top>
        <VBox styleClass="header-vbox">
            <Label text="Clínica Salud Integral" styleClass="header-label" />
        </VBox>
    </top>

    <!-- Contenido principal (TabPane) -->
    <center>
        <TabPane fx:id="tabPane">
            <Tab text="Registrar Paciente" closable="false">
                <VBox spacing="15" styleClass="vbox">
                    <TextField fx:id="cedulaField" promptText="Cédula" styleClass="text-field" />
                    <TextField fx:id="nombreField" promptText="Nombre" styleClass="text-field" />
                    <TextField fx:id="telefonoField" promptText="Teléfono" styleClass="text-field" />
                    <TextField fx:id="emailField" promptText="Email" styleClass="text-field" />
                    <ComboBox fx:id="suscripcionCombo" promptText="Tipo de Suscripción" styleClass="combo-box" />
                    <Button fx:id="registrarBtn" text="Registrar" onAction="#registrarPaciente" styleClass="button" />
                    <Label fx:id="mensajeLabel" styleClass="label" />
                </VBox>
            </Tab>
            <Tab text="Listar Pacientes" closable="false">
                <VBox spacing="15" styleClass="vbox">
                    <Button fx:id="listarPacientesBtn" text="Listar Pacientes" onAction="#listarPacientes" styleClass="button" />
                    <TextArea fx:id="pacientesTextArea" editable="false" styleClass="text-area" />
                </VBox>
            </Tab>
            <Tab text="Agendar Cita" closable="false">
                <VBox spacing="15" styleClass="vbox">
                    <DatePicker fx:id="fechaPicker" promptText="Seleccione la fecha" styleClass="date-picker" />
                    <ComboBox fx:id="horaCombo" promptText="Seleccione la hora" styleClass="combo-box" />
                    <ComboBox fx:id="pacienteCombo" promptText="Seleccionar Paciente" styleClass="combo-box" />
                    <ComboBox fx:id="servicioCombo" promptText="Seleccionar Servicio" styleClass="combo-box" />
                    <Button fx:id="agendarBtn" text="Agendar" onAction="#agendarCita" styleClass="button" />
                    <Label fx:id="mensajeCitaLabel" styleClass="label" />
                </VBox>
            </Tab>
            <Tab text="Listar Citas" closable="false">
                <VBox spacing="15" styleClass="vbox">
                    <Button fx:id="listarCitasBtn" text="Listar Citas" onAction="#listarCitas" styleClass="button" />
                    <TextArea fx:id="citasTextArea" editable="false" styleClass="text-area" />
                </VBox>
            </Tab>
            <Tab text="Cancelar Cita" closable="false">
                <VBox spacing="15" styleClass="vbox">
                    <TextField fx:id="idCitaCancelarField" promptText="ID de la Cita" styleClass="text-field" />
                    <Button fx:id="cancelarCitaBtn" text="Cancelar Cita" onAction="#cancelarCita" styleClass="button" />
                    <Label fx:id="mensajeCancelarLabel" styleClass="label" />
                </VBox>
            </Tab>
            <Tab text="Listar Servicios" closable="false">
                <VBox spacing="15" styleClass="vbox">
                    <Button fx:id="listarServiciosBtn" text="Listar Servicios" onAction="#listarServicios" styleClass="button" />
                    <TextArea fx:id="serviciosTextArea" editable="false" prefHeight="100" styleClass="text-area" />
                    <Label text="Servicios por Suscripción" styleClass="title-label" />
                    <TableView fx:id="serviciosTable" prefHeight="200" styleClass="table-view">
                        <columns>
                            <TableColumn fx:id="nombreColumn" text="Nombre" prefWidth="150" />
                            <TableColumn fx:id="precioColumn" text="Precio" prefWidth="80" />
                            <TableColumn fx:id="incluidoBasicaColumn" text="Incluido Básica" prefWidth="100" />
                            <TableColumn fx:id="descuentoBasicaColumn" text="Descuento Básica" prefWidth="100" />
                            <TableColumn fx:id="precioFinalBasicaColumn" text="Precio Final Básica" prefWidth="100" />
                            <TableColumn fx:id="incluidoPremiumColumn" text="Incluido Premium" prefWidth="100" />
                            <TableColumn fx:id="descuentoPremiumColumn" text="Descuento Premium" prefWidth="100" />
                            <TableColumn fx:id="precioFinalPremiumColumn" text="Precio Final Premium" prefWidth="100" />
                        </columns>
                    </TableView>
                </VBox>
            </Tab>
        </TabPane>
    </center>
</BorderPane>